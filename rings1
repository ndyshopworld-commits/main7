<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>AR Примерка Кольца</title>
    <style>
        body { margin: 0; padding: 0; overflow: hidden; background-color: #000; }
        /* Видео скрыто, показываем только 3D канвас */
        #input_video { display: none; }
        #output_canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; transform: scaleX(-1); /* Зеркалим для селфи-камеры */ }
        
        /* Интерфейс кнопок */
        #ui-container {
            position: absolute;
            bottom: 30px;
            left: 0;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 10;
            gap: 20px;
        }
        
        .arrow-btn {
            background: rgba(255, 255, 255, 0.8);
            border: none;
            border-radius: 50%;
            width: 50px;
            height: 50px;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .arrow-btn:active { background: #fff; transform: scale(0.95); }
        
        #loading {
            position: absolute; top: 50%; left: 50%; 
            transform: translate(-50%, -50%); 
            color: white; font-family: sans-serif; z-index: 20;
            background: rgba(0,0,0,0.7); padding: 10px 20px; border-radius: 8px;
        }
    </style>
</head>
<body>

    <video id="input_video" playsinline></video>
    <canvas id="output_canvas"></canvas>
    <div id="loading">Загрузка нейросети...</div>

    <div id="ui-container">
        <button class="arrow-btn" id="prev-btn">◀</button>
        <button class="arrow-btn" id="next-btn">▶</button>
    </div>

    <script type="module">
        import * as THREE from 'https://cdn.skypack.dev/three@0.128.0';
        import { GLTFLoader } from 'https://cdn.skypack.dev/three@0.128.0/examples/jsm/loaders/GLTFLoader.js';
        import { Hands } from 'https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js';
        import { Camera } from 'https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js';

        // ==========================================
        // НАСТРОЙКИ (МЕНЯТЬ ЗДЕСЬ)
        // ==========================================
        
        // Список ваших моделей. Загрузите файлы .glb в папку с этим файлом
        const models = [
            'ring_01.glb', // Замените на имя вашего файла
            'ring_02.glb', // Замените на имя вашего файла
            'ring_03.glb'  // Замените на имя вашего файла
        ];
        
        // ==========================================

        const videoElement = document.getElementById('input_video');
        const canvasElement = document.getElementById('output_canvas');
        const canvasCtx = canvasElement.getContext('2d');
        const loadingDiv = document.getElementById('loading');
        
        let currentModelIndex = 0;
        let currentRing = null; // Текущий 3D объект кольца

        // 1. Настройка Three.js (3D сцена)
        const scene = new THREE.Scene();
        
        // Камера Three.js должна совпадать с пропорциями экрана
        const camera3D = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera3D.position.z = 2; // Отодвинем камеру чуть назад

        const renderer = new THREE.WebGLRenderer({ canvas: canvasElement, alpha: true });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(window.devicePixelRatio);

        // Свет, чтобы кольцо было видно
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
        scene.add(ambientLight);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 1);
        directionalLight.position.set(0, 10, 10);
        scene.add(directionalLight);

        // Загрузчик моделей
        const loader = new GLTFLoader();

        // Функция загрузки модели
        function loadRing(index) {
            if(models.length === 0) return;
            
            loadingDiv.style.display = 'block';
            loadingDiv.innerText = "Загрузка модели...";

            // Удаляем старое кольцо, если есть
            if (currentRing) {
                scene.remove(currentRing);
                currentRing = null;
            }

            const modelPath = models[index];

            loader.load(
                modelPath,
                (gltf) => {
                    currentRing = gltf.scene;
                    
                    // Начальный масштаб (возможно придется подбирать под вашу модель)
                    // Если кольцо слишком большое, уменьшите эти числа (0.1, 0.1, 0.1)
                    currentRing.scale.set(15, 15, 15); 
                    
                    scene.add(currentRing);
                    loadingDiv.style.display = 'none';
                    console.log(`Loaded: ${modelPath}`);
                },
                undefined,
                (error) => {
                    console.error('Ошибка загрузки модели:', error);
                    loadingDiv.innerText = "Ошибка загрузки (проверьте имя файла)";
                    
                    // Если модели нет, создадим временный "бублик" для теста
                    const geometry = new THREE.TorusGeometry(0.5, 0.1, 16, 100);
                    const material = new THREE.MeshStandardMaterial({ color: 0xffd700 });
                    currentRing = new THREE.Mesh(geometry, material);
                    scene.add(currentRing);
                }
            );
        }

        // Кнопки управления
        document.getElementById('next-btn').onclick = () => {
            currentModelIndex = (currentModelIndex + 1) % models.length;
            loadRing(currentModelIndex);
        };
        document.getElementById('prev-btn').onclick = () => {
            currentModelIndex = (currentModelIndex - 1 + models.length) % models.length;
            loadRing(currentModelIndex);
        };

        // Загружаем первое кольцо при старте
        loadRing(currentModelIndex);

        // 2. Настройка MediaPipe (Распознавание рук)
        function onResults(results) {
            // Отрисовываем видеопоток как фон
            // В Three.js мы делаем фон прозрачным, а видео рисуем через CSS или текстуру
            // Но чтобы не усложнять, мы просто "стираем" канвас, оставляя 3D.
            // Видео должно быть под канвасом (z-index), но MediaPipe может требовать отрисовки.
            // Простейший вариант: делаем renderer.autoClear = false, сначала рисуем видео, потом 3D.
            
            renderer.autoClear = false;
            renderer.clear();
            
            // Рисуем видеопоток на "задний план" канваса (через Three.js это сложно, проще через CSS background)
            // Но для синхронизации, мы отрисуем видео в 2d контекст, но он перекроет 3D...
            // В этом примере мы используем CSS видео как подложку. Canvas прозрачный.
            
            // ЛОГИКА ПОЗИЦИОНИРОВАНИЯ КОЛЬЦА
            if (results.multiHandLandmarks && results.multiHandLandmarks.length > 0) {
                const landmarks = results.multiHandLandmarks[0];

                // Точки безымянного пальца: 13 (MCP - основание), 14 (PIP - костяшка)
                const pointBase = landmarks[13]; 
                const pointMid = landmarks[14];

                if (currentRing) {
                    // 1. Позиция (Конвертация из 0..1 координат экрана в координаты мира Three.js)
                    // Это упрощенная формула. Для идеальной точности нужны матрицы проекции.
                    
                    // Приближенная проекция на плоскость Z=-5
                    const videoWidth = window.innerWidth;
                    const videoHeight = window.innerHeight;
                    
                    // Центр между точками 13 и 14
                    const x = -((pointBase.x + pointMid.x) / 2 - 0.5) * 10; // Инверсия X
                    const y = -((pointBase.y + pointMid.y) / 2 - 0.5) * 10;
                    const z = -5; // Фиксированная глубина пока что (надо вычислять по размеру руки)

                    currentRing.position.set(x, y, z);

                    // 2. Вращение
                    // Вычисляем вектор пальца
                    const dx = (pointMid.x - pointBase.x);
                    const dy = (pointMid.y - pointBase.y);
                    
                    // Простой поворот вокруг оси Z (2D вращение)
                    const angle = Math.atan2(dy, dx); 
                    // Корректируем угол (модели обычно смотрят вверх или вбок)
                    currentRing.rotation.z = -angle + Math.PI / 2; 
                    
                    // Небольшой наклон, чтобы кольцо сидело "на пальце"
                    currentRing.rotation.x = 0.5; 
                }
            }

            renderer.render(scene, camera3D);
        }

        const hands = new Hands({locateFile: (file) => {
            return `https://cdn.jsdelivr.net/npm/@mediapipe/hands/${file}`;
        }});

        hands.setOptions({
            maxNumHands: 1,
            modelComplexity: 1,
            minDetectionConfidence: 0.5,
            minTrackingConfidence: 0.5
        });

        hands.onResults(onResults);

        const camera = new Camera(videoElement, {
            onFrame: async () => {
                await hands.send({image: videoElement});
            },
            width: 1280,
            height: 720
        });
        
        camera.start().then(() => {
            loadingDiv.style.display = 'none';
        });

        // Обработка изменения размера окна
        window.addEventListener('resize', () => {
            camera3D.aspect = window.innerWidth / window.innerHeight;
            camera3D.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    </script>
</body>
</html>
